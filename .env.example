BMP_DEBUG=true
BMP_HOST=0.0.0.0
BMP_PORT=8000
BMP_APP_NAME="投标智航 / TenderPilot"

BMP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bidmaster
BMP_REDIS_URL=redis://localhost:6379/0
BMP_CHROMA_DIR=./chroma_db
BMP_PROJECTS_ROOT=./projects

BMP_LLM_DEFAULT_MODEL=deepseek/deepseek-chat
BMP_LLM_API_KEY=
BMP_LLM_API_BASE=https://api.deepseek.com
BMP_LLM_FALLBACK_MODES=ollama/qwen2.5
BMP_LLM_MAX_RETRIES=3

BMP_EMBEDDING_MODE=api
BMP_EMBEDDING_MODEL=text-embedding-v3
BMP_EMBEDDING_API_KEY=
BMP_EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 资格预审数据飞轮 Trace 存储目录（默认 <projects_root>/_qualification_flywheel）
BMP_QUALIFICATION_TRACE_DIR=

# ── vNext: MinerU OCR（官方云 API v4 / 自建 endpoint / mock）────────
BMP_OCR_MODE=off
BMP_OCR_ENDPOINT=https://api.mineru.net/v4
BMP_OCR_API_KEY=
BMP_OCR_TIMEOUT=60
BMP_OCR_POLL_INTERVAL=3
BMP_OCR_MAX_POLLS=120

# ── vNext: MCP / A2A / AG-UI ─────────────────────────────────────
BMP_MCP_ENABLED=true
BMP_MCP_HTTP_PORT=9001
BMP_A2A_ENABLED=true
BMP_AGUI_ENABLED=true
BMP_PUBLIC_BASE_URL=

# ── vNext: Tracing / 监控 ────────────────────────────────────────
BMP_TRACE_ENABLED=true
BMP_TRACE_DIR=./data/traces
BMP_OTLP_ENDPOINT=

# 开发模式登录（无数据库时可用）
BMP_DEV_LOGIN=true
BMP_DEV_LOGIN_EMAIL=admin@dev.local
BMP_DEV_LOGIN_PASSWORD=dev123

# 数据库可用时创建的默认管理员
BMP_ADMIN_EMAIL=admin@bidmaster.pro
BMP_ADMIN_PASSWORD=admin123
BMP_ADMIN_NAME=平台管理员
